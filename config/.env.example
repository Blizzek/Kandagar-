# Kandagar environment example
# Copy to .env and adjust values

# Server port
PORT=3000

# Path to SQLite database file
DB_PATH=./kandagar.db

# Session secret (change in production)
SESSION_SECRET=kandagar-secret-key-change-in-production

# Global post identifier bound to this installation
POST_ID=1

# Logging level (info, debug, warn, error)
LOG_LEVEL=info
